{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "wopa",
  "main": "src/index.js",
  "compatibility_date": "2026-05-14",
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": ".",
    "binding": "ASSETS"
  },
  "d1_databases": [
    {
      "binding": "WOPA_WAITLIST_DB",
      "database_name": "wopa-waitlist",
      "database_id": "03dbe986-38ae-412d-8d96-85c997d43042"
    }
  ],
  "compatibility_flags": [
    "nodejs_compat"
  ],
  // Secrets are set via `npx wrangler secret put <NAME>` and persist across deploys.
  // Declaring them here documents what the Worker expects; values are never in this file.
  // See DEPLOY.md for the full list.
  "vars": {
    "WHATSAPP_GRAPH_API_VERSION": "v23.0"
  }
}
