{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "wopa",
  "main": "src/index.js",
  "compatibility_date": "2026-05-14",
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": ".",
    "binding": "ASSETS"
  },
  "d1_databases": [
    {
      "binding": "WOPA_WAITLIST_DB",
      "database_name": "wopa-waitlist",
      "database_id": "03dbe986-38ae-412d-8d96-85c997d43042"
    }
  ],
  "compatibility_flags": [
    "nodejs_compat"
  ]
}
